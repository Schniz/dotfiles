{
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "prompt.editor": "<leader>ctrl+e",
    "session.last": "<leader>G"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false
  },
  "animations": true,
  "tabs": {
    "enabled": false
  }
}
